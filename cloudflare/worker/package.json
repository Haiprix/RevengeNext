{
	"name": "altmaster-worker",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"db:local": "wrangler d1 execute altmaster --local --file=./schema.sql",
		"db:remote": "wrangler d1 execute altmaster --remote --file=./schema.sql"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260911.1",
		"typescript": "^5.6.3",
		"wrangler": "^4"
	}
}
