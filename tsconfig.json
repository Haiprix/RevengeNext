{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"types": ["@revenge-mod/types"],
		"paths": {
			"#lib/*": ["./node_modules/@revenge-mod/types/lib/*.d.ts"],
			"@shared/lib/*": ["./shared/lib/*"],
			"@shared/ui/*": ["./shared/ui/*"]
		}
	},
	"include": ["plugins", "types"],
	"exclude": ["plugins/*/build", "cloudflare"]
}
